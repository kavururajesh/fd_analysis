# Copy to .env and adjust. Same names as the existing evaluation/config.py.
GIGACHAT_URL=
GIGACHAT_CERT=
GIGACHAT_KEY=
GIGACHAT_CHAIN=
CHAT_ENDPOINT=/chat/completions
GIGACHAT_MODEL=GigaChat

LLM_MODE=auto            # auto = GigaChat if configured, else offline rule-based engine | gigachat | offline
SOURCE_MODE=local         # local = saved page snapshots | live = real bank sites (config/sources.live.yaml)
BROWSER_CHANNEL=msedge   # msedge | chrome | chromium  (msedge/chrome = already installed, no download)
# BROWSER_PROXY=http://proxy.company:8080
