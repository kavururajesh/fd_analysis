# Copy to .env and adjust. Same names as the existing evaluation/config.py.
GIGACHAT_URL=https://<your-gigachat-host>/v1
GIGACHAT_CERT=C:/Users/<you>/GigaChatCertificates/dev.crt.txt
GIGACHAT_KEY=C:/Users/<you>/GigaChatCertificates/dev.key
GIGACHAT_CHAIN=C:/Users/<you>/GigaChatCertificates/chain_pem.txt
CHAT_ENDPOINT=/chat/completions
GIGACHAT_MODEL=GigaChat

# Testing outside Sber, option A (Groq): LLM_MODE=groq, GROQ_API_KEY=gsk_..., GROQ_MODEL=openai/gpt-oss-120b
# Option B (OpenRouter): LLM_MODE=openrouter and set the two lines below
# OPENROUTER_API_KEY=sk-or-v1-...your key...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
LLM_MODE=groq
SOURCE_MODE=local         # local = saved page snapshots | live = real bank sites (config/sources.live.yaml)
BROWSER_CHANNEL=msedge   # msedge | chrome | chromium  (msedge/chrome = already installed, no download)
# BROWSER_PROXY=http://proxy.company:8080

# ---- Parallel collection (how many banks are read at the same time) ----
COLLECT_WORKERS=3          # 1 = one by one; 3-4 is a good value for a laptop (each worker runs its own browser)
COLLECT_PER_HOST=1         # simultaneous requests to the SAME website (keep 1 to be polite)
COLLECT_LLM_LIMIT=2        # simultaneous LLM calls while the agent learns a new page layout
COLLECT_RETRIES=1          # extra tries after a temporary network error
COLLECT_TOTAL_DEADLINE_S=900   # a stuck page cannot block the whole refresh longer than this
